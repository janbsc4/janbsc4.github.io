---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_posts = site.posts | sort: "date" %}
  {% for post in sitemap_posts %}
    {% unless post.categories contains "hidden" %}
      <url>
        <loc>{{ post.url | absolute_url | xml_escape }}</loc>
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      </url>
    {% endunless %}
  {% endfor %}
  {% for sitemap_page in site.pages %}
    {% unless sitemap_page.sitemap == false %}
      {% assign page_filename = sitemap_page.url | split: "/" | last %}
      {% unless page_filename contains "." %}
        <url>
          <loc>{{ sitemap_page.url | absolute_url | xml_escape }}</loc>
        </url>
      {% endunless %}
    {% endunless %}
  {% endfor %}
</urlset>
