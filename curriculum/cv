#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command_name="${1:-build}"
locale="${2:-en}"

show_help() {
  echo "Usage: curriculum/cv build"
  echo "       curriculum/cv preview [en|es]"
}

build_cv() {
  bundle exec ruby curriculum/scripts/validate.rb
  bundle exec jekyll build --trace --config _config.yml,curriculum/config.yml
}

case "$command_name" in
  build)
    build_cv
    echo "CV previews built in _site/curriculum/"
    ;;
  preview)
    case "$locale" in
      en|es) ;;
      *)
        echo "Unknown CV language: $locale" >&2
        show_help >&2
        exit 1
        ;;
    esac

    build_cv
    preview_path="$repo_root/_site/curriculum/$locale.html"
    if command -v open >/dev/null 2>&1; then
      open "$preview_path"
    else
      echo "Open $preview_path in a browser."
    fi
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    show_help >&2
    exit 1
    ;;
esac
